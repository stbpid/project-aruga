{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "rewrites": [
    { "source": "/",          "destination": "/public/index.html" },
    { "source": "/profiling", "destination": "/public/profiling.html" },
    { "source": "/privacy",   "destination": "/public/privacy.html" },
    { "source": "/contact",   "destination": "/public/contact.html" },
    { "source": "/success",   "destination": "/public/success.html" },
    { "source": "/profile",   "destination": "/public/profile.html" },
    { "source": "/docs",      "destination": "/public/docs.html" },
    { "source": "/api/:path*","destination": "/api/:path*" },
    { "source": "/css/:path*","destination": "/public/css/:path*" },
    { "source": "/js/:path*", "destination": "/public/js/:path*" },
    { "source": "/images/:path*", "destination": "/public/images/:path*" },
    { "source": "/:path*",    "destination": "/public/:path*" }
  ]
}
