{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/images/(.*)", "destination": "/public/images/$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/profiling", "destination": "/public/profiling.html" },
    { "source": "/privacy", "destination": "/public/privacy.html" },
    { "source": "/contact", "destination": "/public/contact.html" },
    { "source": "/success", "destination": "/public/success.html" },
    { "source": "/profile", "destination": "/public/profile.html" },
    { "source": "/docs", "destination": "/public/docs.html" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/login", "destination": "/public/login-dashboard.html" },
    { "source": "/dashboard-admin", "destination": "/public/dashboard-admin.html" },
    { "source": "/dashboard-central", "destination": "/public/dashboard-central.html" },
    { "source": "/dashboard-stu-head", "destination": "/public/dashboard-stu-head.html" },
    { "source": "/dashboard-field-officer", "destination": "/public/dashboard-field-officer.html" }
  ]
}
