{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/profiling",
      "dest": "/public/profiling.html"
    },
    {
      "src": "/privacy",
      "dest": "/public/privacy.html"
    },
    {
      "src": "/contact",
      "dest": "/public/contact.html"
    },
    {
      "src": "/success",
      "dest": "/public/success.html"
    },
    {
      "src": "/profile",
      "dest": "/public/profile.html"
    },
    {
      "src": "/docs",
      "dest": "/public/docs.html"
    },
    {
      "src": "/dashboard",
      "dest": "/public/dashboard.html"
    },
    {
      "src": "/login",
      "dest": "/public/login-dashboard.html"
    },
    {
      "src": "/dashboard-admin",
      "dest": "/public/dashboard-admin.html"
    },
    {
      "src": "/dashboard-central",
      "dest": "/public/dashboard-central.html"
    },
    {
      "src": "/dashboard-stu-head",
      "dest": "/public/dashboard-stu-head.html"
    },
    {
      "src": "/dashboard-field-officer",
      "dest": "/public/dashboard-field-officer.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/(.*\\..+)",
      "dest": "/public/$1"
    }
  ]
}
