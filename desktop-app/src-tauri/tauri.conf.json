{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Aruga Pretest",
  "version": "0.1.0",
  "identifier": "ph.gov.dswd.aruga.pretest",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Project Aruga - Profiling Tool (PRETEST)",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://projectaruga.com http://localhost:8080; object-src 'none'; base-uri 'self'",
      "dangerousDisableAssetCspModification": ["script-src", "style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DSWD Social Technology Bureau",
    "shortDescription": "Project Aruga Profiling Tool - Pretest",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
